generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  WALLET
  CREDIT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ObligationStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContributionType {
  DEPOSIT
  WITHDRAWAL
}

enum NotificationType {
  OBLIGATION_DUE
  OBLIGATION_OVERDUE
  BUDGET_ALERT
  GOAL_NO_PROGRESS
  LIQUIDITY_WARNING
}

model User {
  id            String         @id @default(uuid())
  email         String
  passwordHash  String         @map("password_hash")
  name          String
  timezone      String         @default("America/Lima")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  recurrences   Recurrence[]
  obligations   Obligation[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  tags          Tag[]
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  name           String
  type           AccountType
  currency       String        @default("PEN")
  initialBalance Decimal       @default(0) @map("initial_balance") @db.Decimal(12, 2)
  balance        Decimal       @default(0) @db.Decimal(12, 2)
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[] @relation("TransactionAccount")
  counterpartFor Transaction[] @relation("CounterpartAccount")
  savingsGoals   SavingsGoal[]
  recurrences    Recurrence[]

  @@index([userId, name])
  @@index([userId])
  @@index([deletedAt])
  @@map("accounts")
}

model Category {
  id               String           @id @default(uuid())
  userId           String?          @map("user_id")
  name             String
  type             CategoryType
  parentId         String?          @map("parent_id")
  icon             String?
  color            String?
  isSystem         Boolean          @default(false) @map("is_system")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]       @relation("CategoryHierarchy")
  transactions     Transaction[]
  recurrences      Recurrence[]
  budgetCategories BudgetCategory[]

  @@index([userId, name, type])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Transaction {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  accountId            String             @map("account_id")
  categoryId           String?            @map("category_id")
  type                 TransactionType
  amount               Decimal            @db.Decimal(12, 2)
  currency             String             @default("PEN")
  description          String?
  date                 DateTime           @db.Timestamptz(6)
  status               TransactionStatus  @default(CONFIRMED)
  direction            String?            @map("direction") @db.VarChar(10)
  transferId           String?            @map("transfer_id")
  counterpartAccountId String?            @map("counterpart_account_id")
  obligationId         String?            @map("obligation_id")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(6)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account            @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  counterpartAccount   Account?           @relation("CounterpartAccount", fields: [counterpartAccountId], references: [id], onDelete: SetNull)
  obligation           Obligation?        @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  contributions        GoalContribution[]
  tags                 TransactionTag[]

  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([transferId])
  @@index([obligationId])
  @@index([deletedAt])
  @@map("transactions")
}

model Recurrence {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  name        String
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType
  categoryId  String?             @map("category_id")
  accountId   String?             @map("account_id")
  frequency   RecurrenceFrequency
  dayOfPeriod Int                 @map("day_of_period")
  startDate   DateTime            @map("start_date") @db.Timestamptz(6)
  endDate     DateTime?           @map("end_date") @db.Timestamptz(6)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(6)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account     Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  obligations Obligation[]

  @@index([userId])
  @@index([active])
  @@index([deletedAt])
  @@map("recurrences")
}

model Obligation {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  recurrenceId String?          @map("recurrence_id")
  name         String
  amount       Decimal          @db.Decimal(12, 2)
  dueDate      DateTime         @map("due_date") @db.Timestamptz(6)
  status       ObligationStatus @default(PENDING)
  paidAt       DateTime?        @map("paid_at") @db.Timestamptz(6)
  periodStart  DateTime?        @map("period_start") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrence   Recurrence?      @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([recurrenceId, periodStart])
  @@index([userId, dueDate])
  @@index([status])
  @@index([deletedAt])
  @@map("obligations")
}

model Budget {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  name           String
  period         BudgetPeriod
  amount         Decimal          @db.Decimal(12, 2)
  startDate      DateTime         @map("start_date") @db.Timestamptz(6)
  endDate        DateTime?        @map("end_date") @db.Timestamptz(6)
  alertThreshold Int              @default(80) @map("alert_threshold")
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories     BudgetCategory[]

  @@index([userId])
  @@index([active])
  @@index([deletedAt])
  @@map("budgets")
}

model BudgetCategory {
  id         String   @id @default(uuid())
  budgetId   String   @map("budget_id")
  categoryId String   @map("category_id")
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
  @@map("budget_categories")
}

model SavingsGoal {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  name          String
  targetAmount  Decimal            @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal            @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime?          @map("target_date") @db.Timestamptz(6)
  accountId     String?            @map("account_id")
  status        GoalStatus         @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("savings_goals")
}

model GoalContribution {
  id            String           @id @default(uuid())
  goalId        String           @map("goal_id")
  transactionId String?          @map("transaction_id")
  amount        Decimal          @db.Decimal(12, 2)
  type          ContributionType
  date          DateTime         @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)
  goal          SavingsGoal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([transactionId])
  @@index([deletedAt])
  @@map("goal_contributions")
}

model Tag {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  name         String
  color        String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@index([userId, name])
  @@index([userId])
  @@index([deletedAt])
  @@map("tags")
}

model TransactionTag {
  transactionId String      @map("transaction_id")
  tagId         String      @map("tag_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ip        String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
