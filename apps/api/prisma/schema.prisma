generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  WALLET
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TransferStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ObligationPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BudgetStatus {
  UNDER_LIMIT
  NEAR_LIMIT
  OVER_LIMIT
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContributionType {
  DEPOSIT
  WITHDRAWAL
}

enum NotificationType {
  OBLIGATION_DUE
  OBLIGATION_OVERDUE
  BUDGET_ALERT
  GOAL_NO_PROGRESS
  LIQUIDITY_WARNING
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  timezone      String         @default("America/Lima")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  recurrences   Recurrence[]
  obligations   Obligation[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  tags          Tag[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  name              String
  type              AccountType
  currency          String      @default("PEN") @db.VarChar(3)
  initialBalance    Decimal     @default(0) @map("initial_balance") @db.Decimal(19, 2)
  initialBalanceAt  DateTime    @default(now()) @map("initial_balance_at") @db.Timestamptz(6)
  archived          Boolean     @default(false)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[] @relation("TransactionAccount")
  transfersOut      Transfer[]    @relation("TransferOrigin")
  transfersIn       Transfer[]    @relation("TransferDestination")
  savingsGoals      SavingsGoal[]
  recurrences       Recurrence[]
  obligations       Obligation[]

  @@index([userId, name])
  @@index([userId, deletedAt])
  @@map("accounts")
}

model Category {
  id               String       @id @default(uuid())
  userId           String?      @map("user_id")
  name             String
  type             CategoryType
  parentId         String?      @map("parent_id")
  icon             String?
  color            String?
  isSystem         Boolean      @default(false) @map("is_system")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]       @relation("CategoryHierarchy")
  transactions     Transaction[]
  recurrences      Recurrence[]
  obligations      Obligation[]
  budgetCategories BudgetCategory[]

  @@index([userId, name, type])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Transaction {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  accountId    String            @map("account_id")
  categoryId   String?           @map("category_id")
  type         TransactionType
  amount       Decimal           @db.Decimal(19, 2)
  currency     String            @default("PEN") @db.VarChar(3)
  description  String?
  occurredAt   DateTime          @map("date") @db.Timestamptz(6)
  status       TransactionStatus @default(CONFIRMED)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account             @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  obligationPayments ObligationPayment[]
  goalContributions  GoalContribution[]
  tags               TransactionTag[]

  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([status, occurredAt])
  @@index([deletedAt])
  @@map("transactions")
}

model Transfer {
  id                  String         @id @default(uuid())
  userId              String         @map("user_id")
  originAccountId     String         @map("origin_account_id")
  destinationAccountId String        @map("destination_account_id")
  amount              Decimal        @db.Decimal(19, 2)
  currency            String         @default("PEN") @db.VarChar(3)
  description         String?
  occurredAt          DateTime       @map("occurred_at") @db.Timestamptz(6)
  status              TransferStatus @default(CONFIRMED)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(6)

  originAccount       Account @relation("TransferOrigin", fields: [originAccountId], references: [id], onDelete: Restrict)
  destinationAccount  Account @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([originAccountId, occurredAt])
  @@index([destinationAccountId, occurredAt])
  @@index([status, occurredAt])
  @@map("transfers")
}

model Recurrence {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  name            String
  amount          Decimal             @db.Decimal(19, 2)
  currency        String              @default("PEN") @db.VarChar(3)
  type            TransactionType
  description     String?
  categoryId      String?             @map("category_id")
  accountId       String              @map("account_id")
  frequency       RecurrenceFrequency
  dayOfPeriod     Int?                @map("day_of_period")
  startDate       DateTime            @map("start_date") @db.Timestamptz(6)
  endDate         DateTime?           @map("end_date") @db.Timestamptz(6)
  lastGeneratedAt DateTime?           @map("last_generated_at") @db.Timestamptz(6)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  obligations Obligation[]

  @@index([userId, active])
  @@index([deletedAt])
  @@map("recurrences")
}

model Obligation {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  recurrenceId String?          @map("recurrence_id")
  accountId    String           @map("account_id")
  categoryId   String?          @map("category_id")
  name         String
  type         TransactionType
  amount       Decimal          @db.Decimal(19, 2)
  currency     String           @default("PEN") @db.VarChar(3)
  description  String?
  dueDate      DateTime         @map("due_date") @db.Timestamptz(6)
  status       ObligationStatus @default(PENDING)
  periodStart  DateTime?        @map("period_start") @db.Date
  periodEnd    DateTime?        @map("period_end") @db.Date
  paidAt       DateTime?        @map("paid_at") @db.Timestamptz(6)
  cancelledAt  DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrence Recurrence?         @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments   ObligationPayment[]

  @@unique([recurrenceId, periodStart])
  @@index([userId, dueDate])
  @@index([userId, status, dueDate])
  @@index([deletedAt])
  @@map("obligations")
}

model ObligationPayment {
  id            String                    @id @default(uuid())
  obligationId  String                    @map("obligation_id")
  transactionId String                    @map("transaction_id")
  amount        Decimal                   @db.Decimal(19, 2)
  paidAt        DateTime                  @default(now()) @map("paid_at") @db.Timestamptz(6)
  status        ObligationPaymentStatus   @default(CONFIRMED)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  obligation  Obligation  @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId])
  @@index([obligationId])
  @@map("obligation_payments")
}

model Budget {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  period         BudgetPeriod
  amount         Decimal     @db.Decimal(19, 2)
  currency       String      @default("PEN") @db.VarChar(3)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date") @db.Date
  alertThreshold Int         @default(80) @map("alert_threshold")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@index([userId, active])
  @@index([deletedAt])
  @@map("budgets")
}

model BudgetCategory {
  id         String    @id @default(uuid())
  budgetId   String    @map("budget_id")
  categoryId String    @map("category_id")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  budget     Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([budgetId, deletedAt])
  @@map("budget_categories")
}

model SavingsGoal {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  name         String
  targetAmount Decimal    @map("target_amount") @db.Decimal(19, 2)
  targetDate   DateTime?  @map("target_date") @db.Date
  accountId    String?    @map("account_id")
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId, status])
  @@index([deletedAt])
  @@map("savings_goals")
}

model GoalContribution {
  id            String           @id @default(uuid())
  goalId        String           @map("goal_id")
  transactionId String?          @map("transaction_id")
  amount        Decimal          @db.Decimal(19, 2)
  type          ContributionType
  occurredAt    DateTime         @map("date") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)

  goal        SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, occurredAt])
  @@index([transactionId])
  @@index([deletedAt])
  @@map("goal_contributions")
}

model Tag {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  name      String
  color     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([deletedAt])
  @@map("tags")
}

model TransactionTag {
  transactionId String      @map("transaction_id")
  tagId         String      @map("tag_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ip        String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
