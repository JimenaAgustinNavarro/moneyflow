{
  "name": "moneyflow",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación web de gestión y planificación de finanzas personales.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "npm run build --workspace=@moneyflow/shared",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=apps/api --if-present\" \"npm run dev --workspace=apps/web --if-present\"",
    "prebuild": "npm run build --workspace=@moneyflow/shared",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build --workspace=@moneyflow/shared",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3"
  }
}
